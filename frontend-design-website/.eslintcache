>\r\n        <li className=\"menu-item\">\r\n          <a href=\"#\">Product</a>\r\n        </li>\r\n        <li className=\"menu-item\">\r\n          <a href=\"#\">CAD</a>\r\n        </li>\r\n        <li className=\"menu-item\">\r\n          <a href=\"#\">PCB</a>\r\n        </li>\r\n        <li className=\"menu-item\">\r\n          <a href=\"#\">Silicon</a>\r\n        </li>\r\n        <li className=\"menu-item\">\r\n          <a href=\"#\">Clothes</a>\r\n        </li>\r\n        <li className=\"menu-item\">\r\n          <a href=\"#\">Architecture</a>\r\n        </li>\r\n      </ul>\r\n    </SharedHeader>)\r\n}\r\n","E:\\Struct\\frontend-design-website\\src\\containers\\ChatBot\\Customer.js",["109"],"import React from 'react'\r\nimport './newstyle.css'\r\n\r\nexport default function Customer({message,timeStamp, imageUrl}) {\r\n    return (\r\n        <div>\r\n       \r\n            <div className=\"ChatItem ChatItem--customer\">\r\n                <div className=\"ChatItem-meta\">\r\n                    <div className=\"ChatItem-avatar\">\r\n                        <img className=\"ChatItem-avatarImage\" src={imageUrl} />\r\n                    </div>\r\n                </div>\r\n                <div className=\"ChatItem-chatContent\">\r\n                    <div className=\"ChatItem-chatText\">{message}</div>\r\n                    <div className=\"ChatItem-timeStamp\"><strong>Chat Bot</strong> {timeStamp}</div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n",["110","111"],"E:\\Struct\\frontend-design-website\\src\\containers\\ChatBot\\Expert.js",["112"],"import React from 'react'\r\nimport './newstyle.css'\r\n\r\n\r\n\r\nexport default function Expert({ message, timeStamp, imageUrl }) {\r\n    return (\r\n\r\n        <div className=\"ChatItem ChatItem--expert\">\r\n            <div className=\"ChatItem-meta\">\r\n                <div className=\"ChatItem-avatar\">\r\n                    <img className=\"ChatItem-avatarImage\"\r\n\r\n\r\n                        src={imageUrl} />\r\n                </div>\r\n            </div>\r\n            <div className=\"ChatItem-chatContent\">\r\n                {/* <div className=\"ChatItem-chatText\">    {renderChat()}</div> */}\r\n\r\n                <div className=\"ChatItem-chatText\">  {message}</div>\r\n                <div className=\"ChatItem-timeStamp\"><strong>Me</strong> {timeStamp}</div>\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n","E:\\Struct\\frontend-design-website\\src\\containers\\Chatbot\\index.js",["113"],"E:\\Struct\\frontend-design-website\\src\\containers\\Chatbot\\Expert.js",["114"],"E:\\Struct\\frontend-design-website\\src\\containers\\Chatbot\\Customer.js",["115"],"E:\\Struct\\frontend-design-website\\src\\containers\\Chatbot\\TextEntry.js",[],"E:\\Struct\\frontend-design-website\\src\\containers\\Chatbot\\ChatManager.js",["116","117"],"import React, { useState } from 'react'\r\nimport './newstyle.css'\r\nimport './style.css'\r\nimport TextEntry from './TextEntry';\r\nimport Expert from './Expert'\r\nimport Customer from './Customer'\r\nimport moment from 'moment'\r\n\r\nconst data = [\r\n    { message: \"Hello\", isExpert: true, timeStamp: moment().format('MMMM Do YYYY'), imageUrl: \"https://randomuser.me/api/portraits/women/0.jpg\" },\r\n    { message: \"world\", isExpert: false, timeStamp: moment().format('MMMM Do YYYY'), imageUrl: \"https://image.ibb.co/eTiXWa/avatarrobot.png \" }\r\n]\r\nexport default function NewChatbot() {\r\n\r\n    const [chatList, setChatList] = useState(data);\r\n    const [value, setValue] = useState(\"\");\r\n\r\n    const handleSubmit = value => {\r\n        // setChatList(prev => [...prev, value])\r\n        setChatList([...data, { message: value, isExpert: false }])\r\n        // setValue(\"\")\r\n    };\r\n    const renderChat = () => {\r\n        return chatList.map((item) => {\r\n            if (item.isExpert) {\r\n                return (<Customer\r\n                    message={item.message}\r\n                    timeStamp={item.timeStamp}\r\n                    imageUrl={item.imageUrl} />)\r\n            }\r\n            else {\r\n                return (<Expert\r\n                    message={item.message}\r\n                    timeStamp={item.timeStamp}\r\n                    imageUrl={item.imageUrl} />)\r\n\r\n            }\r\n        }\r\n        );\r\n    }\r\n\r\n    return (\r\n        <div className=\"ChatWindow\">\r\n            <div>CHATBOT</div>\r\n\r\n            {renderChat()}\r\n\r\n            <TextEntry\r\n                handleSubmit={handleSubmit}\r\n            />\r\n\r\n        </div>\r\n\r\n    )\r\n}\r\n",{"ruleId":"118","replacedBy":"119"},{"ruleId":"120","replacedBy":"121"},{"ruleId":"122","severity":1,"message":"123","line":1,"column":8,"nodeType":"124","messageId":"125","endLine":1,"endColumn":12},{"ruleId":"122","severity":1,"message":"126","line":10,"column":3,"nodeType":"124","messageId":"125","endLine":10,"endColumn":7},{"ruleId":"127","severity":1,"message":"128","line":15,"column":33,"nodeType":"129","endLine":15,"endColumn":72},{"ruleId":"130","severity":1,"message":"131","line":40,"column":41,"nodeType":"129","endLine":40,"endColumn":95},{"ruleId":"130","severity":1,"message":"131","line":43,"column":41,"nodeType":"129","endLine":43,"endColumn":97},{"ruleId":"130","severity":1,"message":"131","line":76,"column":37,"nodeType":"129","endLine":76,"endColumn":120},{"ruleId":"130","severity":1,"message":"131","line":107,"column":37,"nodeType":"129","endLine":107,"endColumn":115},{"ruleId":"132","severity":1,"message":"133","line":165,"column":41,"nodeType":"129","endLine":165,"endColumn":109},{"ruleId":"127","severity":1,"message":"128","line":167,"column":37,"nodeType":"129","endLine":167,"endColumn":49},{"ruleId":"127","severity":1,"message":"128","line":173,"column":37,"nodeType":"129","endLine":173,"endColumn":86},{"ruleId":"132","severity":1,"message":"133","line":179,"column":41,"nodeType":"129","e