umn":29,"nodeType":"198","endLine":81,"endColumn":78},{"ruleId":"196","severity":1,"message":"197","line":91,"column":29,"nodeType":"198","endLine":91,"endColumn":78},{"ruleId":"217","severity":1,"message":"218","line":95,"column":25,"nodeType":"198","endLine":95,"endColumn":60},{"ruleId":"217","severity":1,"message":"218","line":101,"column":25,"nodeType":"198","endLine":101,"endColumn":62},{"ruleId":"196","severity":1,"message":"197","line":107,"column":29,"nodeType":"198","endLine":107,"endColumn":78},{"ruleId":"217","severity":1,"message":"218","line":128,"column":37,"nodeType":"198","endLine":128,"endColumn":93},{"ruleId":"217","severity":1,"message":"218","line":137,"column":37,"nodeType":"198","endLine":137,"endColumn":93},{"ruleId":"217","severity":1,"message":"218","line":146,"column":37,"nodeType":"198","endLine":146,"endColumn":93},{"ruleId":"217","severity":1,"message":"218","line":155,"column":37,"nodeType":"198","endLine":155,"endColumn":93},{"ruleId":"201","severity":1,"message":"219","line":2,"column":8,"nodeType":"203","messageId":"204","endLine":2,"endColumn":11},{"ruleId":"201","severity":1,"message":"220","line":4,"column":8,"nodeType":"203","messageId":"204","endLine":4,"endColumn":18},{"ruleId":"201","severity":1,"message":"221","line":4,"column":22,"nodeType":"203","messageId":"204","endLine":4,"endColumn":33},{"ruleId":"205","severity":1,"message":"206","line":36,"column":13,"nodeType":"198","endLine":41,"endColumn":16},"no-native-reassign",["222"],"no-negated-in-lhs",["223"],"jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/evcohen/eslint-plugin-jsx-a11y/blob/master/docs/rules/anchor-is-valid.md","JSXOpeningElement","react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" is a security risk: see https://html.spec.whatwg.org/multipage/links.html#link-type-noopener","no-unused-vars","'Link' is defined but never used.","Identifier","unusedVar","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","'value' is assigned a value but never used.","'setValue' is assigned a value but never used.","'BrowserRouter' is defined but never used.","'Theme' is defined but never used.","'bindPopover' is defined but never used.","'Popover' is defined but never used.","'setOpen' is assigned a value but never used.","'React' is defined but never used.","'MyFactoryFloorDetail' is defined but never used.","'useState' is defined but never used.","jsx-a11y/img-redundant-alt","Redundant alt attribute. Screen-readers already announce `img` tags as an image. You don’t need to use the words `image`, `photo,` or `picture` (or any specified custom words) in the alt prop.","'Box' is defined but never used.","'PopupState' is defined but never used.","'bindTrigger' is defined but never used.","no-global-assign","no-unsafe-negation"]