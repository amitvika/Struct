port React from 'react'\r\nimport {Link} from \"react-router-dom\"\r\n\r\n\r\nexport default function Footer() {\r\n    return (\r\n        <div>\r\n\r\n            <footer className=\"footer-area\" style={{ overflow: 'hidden' }}>\r\n                <div className=\"footer-top\">\r\n                    <div className=\"container\">\r\n                        <div className=\"row footer_sidebar\">\r\n                            <div className=\"col-xs-6 col-sm-6 col-md-3\">\r\n                                <div className=\"widget widget1 about_us_widget\">\r\n                                    <a href=\"#\" className=\"logo\">\r\n                                        <img src=\"assets/images/logo.png\" alt=\"f-logo\" />\r\n                                    </a>\r\n                                    <p>Lorem ipsum dolor sit consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam quis nostrud.</p>\r\n                                    <ul className=\"nav social_icon row m0\">\r\n                                        <li><a target=\"_blank\" href=\"#\"><i className=\"fa fa-facebook\" /></a></li>\r\n                                        <li><a target=\"_blank\" href=\"#\"><i className=\"fa fa-twitter\" /></a></li>\r\n                                        <li><a target=\"_blank\" href=\"#\"><i className=\"fa fa-instagram\" /></a></li>\r\n                                        <li><a target=\"_blank\" href=\"#\"><i className=\"fa fa-linkedin\" /></a></li>\r\n                                        <li><a target=\"_blank\" href=\"#\"><i className=\"fa fa-google-plus\" /></a></li>\r\n                                        <li><a target=\"_blank\" href=\"#\"><i className=\"fa fa-pinterest-p\" /></a></li>\r\n                                    </ul>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"col-xs-6 col-sm-6 col-md-3\">\r\n                                <div className=\"widget widget2 widget_contact\">\r\n                                    <h4 className=\"widget_title\">CONTACT INFO</h4>\r\n                                    <div className=\"widget_inner row m0\">\r\n                                        <ul>\r\n                                            <li>\r\n                                                <i className=\"ti-location-pin\" />\r\n                                                <div className=\"location_address fleft\">\r\n                                                    25 Bedford St. <br />\r\n                          New York City, N.Y.\r\n                        </div>\r\n                                            </li>\r\n                                            <li>\r\n                                                <i className=\"ti-mobile\" />\r\n                                                <div className=\"fleft contact_no\">\r\n                                                    <a href=\"#\">+8801236 47896</a>\r\n                                                </div>\r\n                                            </li>\r\n                                            <li>\r\n                                                <i className=\"ti-email\" />\r\n                                                <div className=\"fleft contact_mail\">\r\n                                                    <a href=\"#\">inova.theme@gmail.com</a>\r\n                                                </div>\r\n                                            </li>\r\n                                        </ul>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"col-xs-6 col-sm-6 col-md-3\">\r\n                                <li className=\"widget tweets-widget\">\r\n                                    <h2 className=\"widget_title\">Twitter Feeds</h2>\r\n                                    <ul className=\"tweets\">\r\n                                        <li>\r\n                                            <div>Are you planning to build your <a href=\"#\" target=\"_blank\">#Website</a> in a <a href=\"#\" target=\"_blank\">#trendy</a> &amp; modern style like a “Split Slider”? Our Saasland MultiPurpos… <a href=\"#\" target=\"_blank\">https://t.co/Uj3W4EES1o</a></div>\r\n                                            <span><i className=\"fa fa-twitter\" /> 6m ago </span>\r\n                                        </li>\r\n                                    </ul>\r\n                                </li>\r\n                            </div>\r\n                            <div className=\"col-xs-6 col-sm-6 col-md-3\">\r\n                                …\r\n              </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row m0 footer_bottom\">\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-4\">\r\n                                {/* This will generate HTML, that's why this is ecoed as shortcode. It shouldn't be escaped with esc_html as it will generate HTML */}\r\n                2018 All Right Reserved | <a href=\"#\">DroitThemes</a>\r\n                                <p />\r\n                            </div>\r\n                            <div className=\"right col-sm-8\">\r\n                                <div className=\"menu-quick-links-container\">\r\n                                    <ul id=\"menu-quick-links\" className=\"footer-menu\">\r\n                                        <li className=\"menu-item menu-item-type-custom menu-item-object-custom\"><a href=\"#\">About</a></li>\r\n                                        <li className=\"menu-item menu-item-type-custom menu-item-object-custom\"><a href=\"#\">Help</a></li>\r\n                                        <li className=\"menu-item menu-item-type-custom menu-item-object-custom\"><a href=\"#\">Contact</a></li>\r\n                                        <li className=\"menu-item menu-item-type-custom menu-item-object-custom\"><a href=\"#\">Terms</a></li>\r\n                                        <li className=\"menu-item menu-item-type-custom menu-item-object-custom\"><a href=\"#\">Privacy</a></li>\r\n                                    </ul>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </footer>\r\n        </div>\r\n     \r\n    )\r\n}\r\n","E:\\Struct\\frontend-public\\src\\containers\\Chatbot\\index.js",["158"],"import React, { useState } from 'react';\r\nimport './style.css'\r\nimport ChatManager from './ChatManager'\r\n// import ChatIcon from '@material-ui/icons/Chat';\r\nimport ChatIcon from '../../assets/images/Chatbot_icon.jpg'\r\n\r\nfunction Chatbot() {\r\n    const [isChatBoxVisible, setisChatBoxVisible] = useState(false)\r\n\r\n    const handleChatBoxClick = () => {\r\n        console.log('Button clicked')\r\n        setisChatBoxVisible(!isChatBoxVisible)\r\n    }\r\n\r\n\r\n    return (\r\n        <div className=\"Chatbot_main\"\r\n            id=\"openChatBox\">\r\n            {\r\n                isChatBoxVisible ?\r\n                    <ChatManager /> : null\r\n            }\r\n\r\n            <button className=\"Submit_btn\"\r\n                onClick={handleChatBoxClick}>\r\n                <img className=\"Chat_btn\" src={ChatIcon}></img>\r\n                {/* <ChatIcon style={{\r\n                    fontSize: \"66px\",\r\n                    marginRight: \"4px\"\r\n                }} /> */}\r\n            </button>\r\n\r\n        </div>\r\n    )\r\n\r\n}\r\nexport default Chatbot\r\n","E:\\Struct\\frontend-public\\src\\containers\\Chatbot\\ChatManager.js",["159","160"],"import React, { useState } from 'react'\r\nimport './newstyle.css'\r\nimport './style.css'\r\nimport TextEntry from './TextEntry';\r\nimport Expert from './Expert'\r\nimport Customer from './Customer'\r\nimport moment from 'moment'\r\n\r\nconst data = [\r\n    { message: \"Hello\", isExpert: true, timeStamp: moment().format('MMMM Do YYYY'), imageUrl: \"https://randomuser.me/api/portraits/women/0.jpg\" },\r\n    { message: \"world\", isExpert: false, timeStamp: moment().format('MMMM Do YYYY'), imageUrl: \"https://image.ibb.co/eTiXWa/avatarrobot.png \" }\r\n]\r\nexport default function NewChatbot() {\r\n\r\n    const [chatList, setChatList] = useState(data);\r\n    const [value, setValue] = useState(\"\");\r\n\r\n    const handleSubmit = value => {\r\n        setChatList(prev => [...prev, { message: value, isExpert: false }])\r\n        // setChatList([...data, { message: value, isExpert: false }])\r\n        // setValue(\"\")\r\n    };\r\n    const renderChat = () => {\r\n        return chatList.map((item) => {\r\n            if (item.isExpert) {\r\n                return (<Customer\r\n                    message={item.message}\r\n                    timeStamp={item.timeStamp}\r\n                    imageUrl={item.imageUrl} />)\r\n            }\r\n            else {\r\n                return (<Expert\r\n                    message={item.message}\r\n                    timeStamp={item.timeStamp}\r\n                    imageUrl={item.imageUrl} />)\r\n            }\r\n        }\r\n        );\r\n    }\r\n    return (\r\n        <div className=\"ChatWindow\">\r\n            <div>CHATBOT</div>\r\n            {renderChat()}\r\n            <TextEntry\r\n                handleSubmit={handleSubmit}\r\n            />\r\n        </div>\r\n\r\n    )\r\n}\r\n","E:\\Struct\\frontend-public\\src\\containers\\Chatbot\\Expert.js",["161"],"import React from 'react'\r\nimport './newstyle.css'\r\n\r\n\r\n\r\nexport default function Expert({ message, timeStamp, imageUrl }) {\r\n    return (\r\n\r\n        <div className=\"ChatItem ChatItem--expert\">\r\n            <div className=\"ChatItem-meta\">\r\n                <div className=\"ChatItem-avatar\">\r\n                    <img className=\"ChatItem-avatarImage\"\r\n                        src={imageUrl} />\r\n                </div>\r\n            </div>\r\n            <div className=\"ChatItem-chatContent\">\r\n                {/* <div className=\"ChatItem-chatText\">    {renderChat()}</div> */}\r\n                \r\n                <div className=\"ChatItem-chatText\">  {message}</div>\r\n                <div className=\"ChatItem-timeStamp\"><strong>Me</strong> {timeStamp}</div>\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n","E:\\Struct\\frontend-public\\src\\containers\\Chatbot\\TextEntry.js",[],"E:\\Struct\\frontend-public\\src\\containers\\Chatbot\\Customer.js",["162"],"import React from 'react'\r\nimport './newstyle.css'\r\n\r\nexport default function Customer({message,timeStamp, imageUrl}) {\r\n    return (\r\n        <div>\r\n       \r\n            <div className=\"ChatItem ChatItem--customer\">\r\n                <div className=\"ChatItem-meta\">\r\n                    <div className=\"ChatItem-avatar\">\r\n                        <img className=\"ChatItem-avatarImage\" src={imageUrl} />\r\n                    </div>\r\n                </div>\r\n                <div className=\"ChatItem-chatContent\">\r\n                    <div className=\"ChatItem-chatText\">{message}</div>\r\n                    <div className=\"ChatItem-timeStamp\"><strong>Chat Bot</strong> {timeStamp}</div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n","E:\\Struct\\frontend-public\\src\\components\\Layout.js",[],"E:\\Struct\\frontend-public\\src\\dashboardRoutes.js",["163","164"],"E:\\Struct\\frontend-public\\src\\components\\NavigationBar\\NavigationBar.jsx",["165","166","167","168","169"],"E:\\Struct\\frontend-public\\src\\routes.js