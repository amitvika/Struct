{
  "name": "struct",
  "version": "1.0.0",
  "description": "All the code, in one place",
  "main": "index.js",
  "scripts": {
    "setup": "npm install  ./ && npm install ./frontend-internal && npm install  ./backend-node  && npm install ./frontend-public",
    "*****Server*****": "Node backend",
    "server": "cd backend-node && npm run server",
    "*****Internal*****": "Internal Website",
    "internal": "cd frontend-internal && npm start",
    "*****Public*****": "Public website",
    "public": "cd frontend-public && npm start",
    "*****Development*****": "Start development environment",
    "dev": "concurrently \"npm run server\" \"npm run internal\" "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitvika/Struct.git"
  },
