],["128","129"],"E:\\Struct\\frontend-public\\src\\reportWebVitals.js",[],"E:\\Struct\\frontend-public\\src\\containers\\Header.js",["130","131","132","133","134","135","136","137","138","139","140","141","142","143","144","145","146"],"import React, { useEffect, useState } from 'react'\r\nimport SharedHeader from 'shared-lib/src/components/Header';\r\nimport {Link} from\"react-router-dom\"\r\n\r\n\r\n\r\nexport default function Header(props) {\r\n\r\n\r\n\r\n  const [nav, setNav] = useState(false);\r\n\r\n  useEffect(() => {\r\n    window.addEventListener(\"scroll\", handleScroll);\r\n    return () => {\r\n      window.removeEventListener('scroll', () => { });\r\n    }\r\n  }, [])\r\n\r\n  const handleScroll = () => {\r\n    if (window.pageYOffset > 0) {\r\n      setNav(true);\r\n    } else {\r\n\r\n      setNav(false);\r\n    }\r\n\r\n  }\r\n\r\n  // Google Login\r\n  // const handleLogin = async googleData => {\r\n    // history.push(\"/login\")\r\n    // console.log(googleData);\r\n    // const res = await fetch(\"/api/v1/auth/google\", {\r\n    //   method: \"POST\",\r\n    //   body: JSON.stringify({\r\n    //     token: googleData.tokenId\r\n    //   }),\r\n    //   headers: {\r\n    //     \"Content-Type\": \"application/json\"\r\n    //   }\r\n    // })\r\n    // const data = await res.json()\r\n    // // store returned user somehow\r\n  \r\n\r\n\r\n\r\n  return (\r\n\r\n    <SharedHeader nav={nav} menuButton={props.children}>\r\n      <ul id=\"nav\" className=\"nav navbar-nav menu\">\r\n        <li className=\"menu-item\">\r\n          <a href=\"#\">Design Quote</a>\r\n          <ul className=\"sub-menu\">\r\n            <li className=\"menu-item\"><a href=\"#\">Product Landing 1</a></li>\r\n            <li className=\"menu-item\"><a href=\"#\">Product Landing 2</a></li>\r\n            <li className=\"menu-item\"><a href=\"#\">Digital Agency</a></li>\r\n            <li className=\"menu-item\"><a href=\"#\">Startup</a></li>\r\n            <li className=\"menu-item\"><a href=\"#\">Saas/Software</a></li>\r\n            <li className=\"menu-item\"><a href=\"#\">App Showcase</a></li>\r\n            <li className=\"menu-item\"><a href=\"#\">SEO/Marketing</a></li>\r\n            <li className=\"menu-item\"><a href=\"#\">Book/eBook</a></li>\r\n          </ul>\r\n        </li>\r\n\r\n        <li className=\"menu-item\">\r\n          <a href=\"http://localhost:3002\" target=\"_blank\">Develop Products</a>\r\n        </li>\r\n        <li className=\"menu-item\">\r\n          <a href=\"#\">Company</a>\r\n          <ul className=\"sub-menu\">\r\n            <li className=\"menu-item\"><a href=\"#\">Services</a></li>\r\n            <li className=\"menu-item\"><a href=\"#\">Features</a></li>\r\n            <li className=\"menu-item\"><a href=\"#\">About</a></li>\r\n            <li className=\"menu-item\"><a href=\"#\">Pricing</a></li>\r\n            <li className=\"menu-item\"><a href=\"#\">Faq</a></li>\r\n            <li className=\"menu-item\"><a href=\"#\">Contact</a></li>\r\n          </ul>\r\n        </li>\r\n\r\n\r\n        <li className=\"menu-item\">\r\n          <Link to=\"/login\">\r\n           Login\r\n          </Link>\r\n          {/* <GoogleLogin\r\n            clientId={process.env.REACT_APP_GOOGLE_CLIENT_ID}\r\n            render={renderProps => (\r\n              <div style={{ height: '100%' }}>\r\n                <a>\r\n                  <button style={{\r\n                    background: 'none', color: nav ? 'black' : 'white',\r\n                    border: 'none'\r\n                  }} onClick={renderProps.onClick} disabled={renderProps.disabled}>Google Log in </button>\r\n                </a>\r\n              </div>\r\n            )}\r\n\r\n            buttonText=\"Log in with Google\"\r\n            onSuccess={handleLogin}\r\n            onFailure={handleLogin}\r\n            cookiePolicy={'single_host_origin'}\r\n          />\r\n        */}\r\n        </li>\r\n      </ul>\r\n\r\n    </SharedHeader>\r\n\r\n  )\r\n}\r\n","E:\\Struct\\frontend-public\\src\\containers\\Footer.js",["147","148","149","150","151","152","153","154","155","156","157","158","159","160","161","162","163","164","165"],"import React from 'react'\r\nimport {Link} from \"react-router-dom\"\r\n\r\n\r\nexport default function Footer() {\r\n    return (\r\n        <div>\r\n\r\n            <footer className=\"footer-area\" style={{ overflow: 'hidden' }}>\r\n                <div className=\"footer-top\">\r\n                    <div className=\"container\">\r\n                        <div className=\"row footer_sidebar\">\r\n                            <div className=\"col-xs-6 col-sm-6 col-md-3\">\r\n                                <div className=\"widget widget1 about_us_widget\">\r\n                                    <a href=\"#\" className=\"logo\">\r\n                                        <img src=\"assets/images/logo.png\" alt=\"f-logo\" />\r\n                                    </a>\r\n                                    <p>Lorem ipsum dolor sit consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam quis nostrud.</p>\r\n                                    <ul className=\"nav social_icon row m0\">\r\n                                        <li><a target=\"_blank\" href=\"#\"><i className=\"fa fa-facebook\" /></a></li>\r\n                                        <li><a target=\"_blank\" href=\"#\"><i className=\"fa fa-twitter\" /></a></li>\r\n                                        <li><a target=\"_blank\" href=\"#\"><i className=\"fa fa-instagram\" /></a></li>\r\n                                        <li><a target=\"_blank\" href=\"#\"><i className=\"fa fa-linkedin\" /></a></li>\r\n                                        <li><a target=\"_blank\" href=\"#\"><i className=\"fa fa-google-plus\" /></a></li>\r\n                                        <li><a target=\"_blank\" href=\"#\"><i className=\"fa fa-pinterest-p\" /></a></li>\r\n                                    </ul>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"col-xs-6 col-sm-6 col-md-3\">\r\n                                <div className=\"widget widget2 widget_contact\">\r\n                                    <h4 className=\"widget_title\">CONTACT INFO</h4>\r\n                                    <div className=\"widget_inner row m0\">\r\n                                        <ul>\r\n                                            <li>\r\n                                                <i className=\"ti-location-pin\" />\r\n                                                <div className=\"location_address fleft\">\r\n                                                    25 Bedford St. <br />\r\n                          New York City, N.Y.\r\n                        </div>\r\n                                            </li>\r\n                                            <li>\r\n                                                <i className=\"ti-mobile\" />\r\n                                                <div className=\"fleft contact_no\">\r\n                                                    <a href=\"#\">+8801236 47896</a>\r\n                                                </div>\r\n                                            </li>\r\n                                            <li>\r\n                                                <i className=\"ti-email\" />\r\n                                                <div className=\"fleft contact_mail\">\r\n                                                    <a href=\"#\">inova.theme@gmail.com</a>\r\n                                                </div>\r\n                                            </li>\r\n                                        </ul>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"col-xs-6 col-sm-6 col-md-3\">\r\n                                <li className=\"widget tweets-widget\">\r\n                                    <h2 className=\"widget_title\">Twitter Feeds</h2>\r\n                                    <ul className=\"tweets\">\r\n                                        <li>\r\n                                            <div>Are you planning to build your <a href=\"#\" target=\"_blank\">#Website</a> in a <a href=\"#\" target=\"_blank\">#trendy</a> &amp; modern style like a “Split Slider”? Our Saasland MultiPurpos… <a href=\"#\" target=\"_blank\">https://t.co/Uj3W4EES1o</a></div>\r\n                                            <span><i className=\"fa fa-twitter\" /> 6m ago </span>\r\n                                        </li>\r\n                                    </ul>\r\n                                </li>\r\n                            </div>\r\n                            <div className=\"col-xs-6 col-sm-6 col-md-3\">\r\n                                …\r\n              </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div className=\"row m0 footer_bottom\">\r\n                    <div className=\"container\">\r\n                        <div className=\"row\">\r\n                            <div className=\"col-sm-4\">\r\n                                {/* This will generate HTML, that's why this is ecoed as shortcode. It shouldn't be escaped with esc_html as it will generate HTML */}\r\n                2018 All Right Reserved | <a href=\"#\">DroitThemes</a>\r\n                                <p />\r\n                            </div>\r\n                            <div className=\"right col-sm-8\">\r\n                                <div className=\"menu-quick-links-container\">\r\n                                    <ul id=\"menu-quick-links\" className=\"footer-menu\">\r\n                                        <li className=\"menu-item menu-item-type-custom menu-item-object-custom\"><a href=\"#\">About</a></li>\r\n                                        <li className=\"menu-item menu-item-type-custom menu-item-object-custom\"><a href=\"#\">Help</a></li>\r\n                                        <li className=\"menu-item menu-item-type-custom menu-item-object-custom\"><a href=\"#\">Contact</a></li>\r\n                                        <li className=\"menu-item menu-item-type-custom menu-item-object-custom\"><a href=\"#\">Terms</a></li>\r\n                                        <li className=\"menu-item menu-item-type-custom menu-item-object-custom\"><a href=\"#\">Privacy</a></li>\r\n                                    </ul>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </footer>\r\n        </div>\r\n     \r\n    )\r\n}\r\n","E:\\Struct\\frontend-public\\src\\containers\\Chatbot\\index.js",["166"],"import React, { useState } from 'react';\r\nimport './style.css'\r\nimport ChatManager from './ChatManager'\r\n// import ChatIcon from '@material-ui/icons/Chat';\r\nimport ChatIcon from '../../assets/images/Chatbot_icon.jpg'\r\n\r\nfunction Chatbot() {\r\n    const [isChatBoxVisible, setisChatBoxVisible] = useState(false)\r\n\r\n    const handleChatBoxClick = () => {\r\n        console.log('Button clicked')\r\n        setisChatBoxVisible(!isChatBoxVisible)\r\n    }\r\n\r\n\r\n    return (\r\n        <div className=\"Chatbot_main\"\r\n            id=\"openChatBox\">\r\n            {\r\n                isChatBoxVisible ?\r\n                    <ChatManager /> : null\r\n            }\r\n\r\n            <button className=\"Submit_btn\"\r\n                onClick={handleChatBoxClick}>\r\n                <img className=\"Chat_btn\" src={ChatIcon}></img>\r\n                {/* <ChatIcon style={{\r\n                    fontSize: \"66px\",\r\n                    marginRight: \"4px\"\r\n                }} /> */}\r\n            </button>\r\n\r\n        </div>\r\n    )\r\n\r\n}\r\nexport default Chatbot\r\n","E:\\Struct\\frontend-public\\src\\containers\\Chatbot\\ChatManager.js",["167","168"],"import React, { useState } from 'react'\r\nimport './newstyle.css'\r\nimport './style.css'\r\nimport TextEntry from './TextEntry';\r\nimport Expert from './Expert'\r\nimport Customer from './Customer'\r\nimport moment from 'moment'\r\n\r\nconst data = [\r\n    { message: \"Hello\", isExpert: true, timeStamp: moment().format('MMMM Do YYYY'), imageUrl: \"https://randomuser.me/api/portraits/women/0.jpg\" },\r\n    { message: \"world\", isExpert: false, timeStamp: moment().format('MMMM Do YYYY'), imageUrl: \"https://image.ibb.co/eTiXWa/avatarrobot.png \" }\r\n]\r\nexport default function NewChatbot() {\r\n\r\n    const [chatList, setChatList] = useState(data);\r\n    const [value, setValue] = useState(\"\");\r\n\r\n    const handleSubmit = value => {\r\n        setChatList(prev => [...prev, { message: value, isExpert: false }])\r\n        // setChatList([...data, { message: value, isExpert: false }])\r\n        // setValue(\"\")\r\n    };\r\n    const renderChat = () => {\r\n        return chatList.map((item) => {\r\n            if (item.isExpert) {\r\n                return (<Customer\r\n                    message={item.message}\r\n                    timeStamp={item.timeStamp}\r\n                    imageUrl={item.imageUrl} />)\r\n            }\r\n            else {\r\n                return (<Expert\r\n                    message={item.message}\r\n                    timeStamp={item.timeStamp}\r\n                    imageUrl={item.imageUrl} />)\r\n            }\r\n        }\r\n        );\r\n    }\r\n    return (\r\n        <div className=\"ChatWindow\">\r\n            <div>CHATBOT</div>\r\n            {renderChat()}\r\n            <TextEntry\r\n                handleSubmit={handleSubmit}\r\n            />\r\n        </div>\r\n\r\n    )\r\n}\r\n","E:\\Struct\\frontend-public\\src\\containers\\Chatbot\\Expert.js",["169"],"import React from 'react'\r\nimport './newstyle.css'\r\n\r\n\r\n\r\nexport default function Expert({ message, timeStamp, imageUrl }) {\r\n    return (\r\n\r\n        <div className=\"ChatItem ChatItem--expert\">\r\n            <div className=\"ChatItem-meta\">\r\n                <div className=\"ChatItem-avatar\">\r\n                    <img className=\"ChatItem-avatarImage\"\r\n                        src={imageUrl} />\r\n                </div>\r\n            </div>\r\n            <div className=\"ChatItem-chatContent\">\r\n                {/* <div className=\"ChatItem-chatText\">    {renderChat()}</div> */}\r\n                \r\n                <div className=\"ChatItem-chatText\">  {message}</div>\r\n                <div className=\"ChatItem-timeStamp\"><strong>Me</strong> {timeStamp}</div>\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n","E:\\Struct\\frontend-public\\src\\containers\\Chatbot\\TextEntry.js",[],["170","171"],"E:\\Struct\\frontend-public\\src\\containers\\Chatbot\\Customer.js",["172"],"import React from 'react'\r\nimport './newstyle.css'\r\n\r\nexport default function Customer({message,timeStamp, imageUrl}) {\r\n    return (\r\n        <div>\r\n       \r\n            <div className=\"ChatItem ChatItem--customer\">\r\n                <div className=\"ChatItem-meta\">\r\n                    <div className=\"ChatItem-avatar\">\r\n                        <img className=\"ChatItem-avatarImage\" src={imageUrl} />\r\n                    </div>\r\n                </div>\r\n                <div className=\"ChatItem-chatContent\">\r\n                    <div className=\"ChatItem-chatText\">{message}</div>\r\n                    <div className=\"ChatItem-timeStamp\"><strong>Chat Bot</strong> {timeStamp}</div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n    )\r\n}\r\n","E:\\Struct\\frontend-public\\src\\components\\Layout.js",[],"E:\\Struct\\frontend-public\\src\\dashboardRoutes.js",["173","174"],"E:\\Struct\\frontend-public\\src\\components\\NavigationBar\\NavigationBar.jsx",["175","176","177","178","179"],"import React, { useState } from 'react';\r\nimport { Link, NavLink, withRouter } from 'react-router-dom';\r\nimport Routes from '../../Routes';\r\nimport AccountCircleIcon from '@material-ui/icons/AccountCircle';\r\nimport { createStyles, makeStyles, Theme } from '@material-ui/core/styles';\r\nimport {\r\n  Paper,\r\n  AppBar,\r\n  Toolbar,\r\n  Typography,\r\n  IconButton,\r\n  Drawer,\r\n  MenuList,\r\n  MenuItem,\r\n  ListItemText,\r\n} from '@material-ui/core';\r\nimport MenuIcon from '@material-ui/icons/Menu';\r\nimport LoginPopup from '../LoginPopup';\r\nimport PopupState, { bindTrigger, bindPopover } from 'material-ui-popup-state';\r\nimport Popover from '@material-ui/core/Popover';\r\n\r\nconst useStyles = makeStyles((theme) =>\r\n  createStyles({\r\n    root: {\r\n      flexGrow: 1,\r\n      margin: \"0px\",\r\n      color: \"#68696a\",\r\n    },\r\n    menuButton: {\r\n      marginRight: theme.spacing(2),\r\n    },\r\n    title: {\r\n      flexGrow: 1,\r\n      textAlign: \"start\"\r\n    },\r\n    drawer: {\r\n      width: 300,\r\n      marginTop: \"64px\"\r\n    },\r\n    fullList: {\r\n      width: 'auto',\r\n    },\r\n  }),\r\n);\r\n\r\nconst NavigationBar = (props) => {\r\n  const classes = useStyles();\r\n  const [open, setOpen] = React.useState(false);\r\n  const anchorRef = React.useRef(null);\r\n\r\n\r\n  // return focus to the button when we transitioned from !open -> open\r\n  const prevOpen = React.useRef(open);\r\n  React.useEffect(() => {\r\n    if (prevOpen.current === true && open === false) {\r\n      anchorRef.current.focus();\r\n    }\r\n\r\n    prevOpen.current = open;\r\n  }, [open]);\r\n\r\n  const [isOpen, setIsOpen] = useState(false);\r\n  const toggleDrawer = (open) => (\r\n    event\r\n  ) => {\r\n    if (\r\n      event.type === 'keydown' &&\r\n      ((event).key === 'Tab' ||\r\n        (event).key === 'Shift')\r\n    ) {\r\n      return;\r\n    }\r\n\r\n    setIsOpen(open);\r\n  };\r\n\r\n  const activeRoute = (routeName) => {\r\n    return props.location.pathname === routeName ? true : false;\r\n  }\r\n\r\n  return (\r\n    <div>\r\n      <div className={classes.root}>\r\n        <AppBar position=\"fixed\"  >\r\n          <Toolbar>\r\n            <IconButton edge=\"start\" className={classes.menuButton} color=\"inherit\" aria-label=\"menu\" onClick={toggleDrawer(true)}>\r\n              <MenuIcon />\r\n            </IconButton>\r\n            <Typography variant=\"h3\" className={classes.title}>\r\n              {props.title}\r\n            </Typography>\r\n            <>\r\n              <PopupState variant=\"popover\" popupId=\"demo-popup-popover\">\r\n                {(popupState) => (\r\n                  <div>\r\n                    <div  {...bindTrigger(popupState)} >\r\n                      <AccountCircleIcon style={{ color: \"white\" }} fontSize=\"large\" />\r\n                    </div>\r\n                    <LoginPopup popupState={popupState} />\r\n                  </div>\r\n\r\n                )}\r\n              </PopupState>\r\n            </>\r\n\r\n          </Toolbar>\r\n        </AppBar>\r\n      </div>\r\n\r\n      <Drawer classes={{ paper: classes.drawer }} open={isOpen} onClose={toggleDrawer(false)}>\r\n        <div\r\n          className={classes.fullList}\r\n          role=\"presentation\"\r\n          onClick={toggleDrawer(false)}\r\n          onKeyDown={toggleDrawer(false)}\r\n        >\r\n\r\n          <MenuList>\r\n            {Routes.map((prop, key) => {\r\n              return (\r\n                <NavLink to={prop.path} key={key}>\r\n                  <Paper>\r\n                    <MenuItem style={{\r\n                      textAlign: \"center\",\r\n                    }}\r\n                      selected={activeRoute(prop.path)}>\r\n\r\n                      <ListItemText primary={prop.sidebarName} />\r\n                    </MenuItem>\r\n                  </Paper>\r\n                </NavLink>\r\n              );\r\n            })}\r\n          </MenuList>\r\n\r\n        </div>\r\n      </Drawer>\r\n\r\n    </div >\r\n\r\n  );\r\n};\r\n\r\nexport default withRouter(NavigationBar);","E:\\Struct\\frontend-public\\src\\routes.jsx",[],"E:\\Struct\\frontend-public\\src\\App.js",[],"E:\\Struct\\frontend-public\\src\\Routes.jsx",["180"],"import React from 'react';\r\nimport MyMachines from './containers/MyMachines/index'\r\nimport MyFactoryFloor from './containers/MyFactoryFloor/index' \r\nimport MyMachinesDetail from './containers/MyMachineDetail'\r\nimport MyFactoryFloorDetail from './containers/MyFactoryFloorDetail'\r\nimport Dashborad from './containers/Dashboard';\r\nimport Manufacture from './containers/Manufacture';\r\nimport Purchases from './containers/Purchaches';\r\nimport Billing from './containers/Billing'\r\n\r\nconst Routes = [\r\n  \r\n  {\r\n    path: '/dashboard',\r\n    component: Dashborad\r\n  },\r\n  {\r\n    path: '/myMachines',\r\n    sidebarName: 'My Machines',\r\n    component: MyMachines\r\n  },\r\n  {\r\n    path: '/myFactoryFloor',\r\n    sidebarName: 'My Factory Floor',\r\n    component: MyFactoryFloor\r\n  },\r\n  \r\n  {\r\n    path: '/manufacture',\r\n    sidebarName: 'Manufacture ',\r\n    component: Manufacture\r\n  },\r\n  {\r\n    path: '/purchases',\r\n    sidebarName: 'Purchases ',\r\n    component: Purchases\r\n  }, {\r\n    path: '/billing',\r\n    sidebarName: 'Billing ',\r\n    component: Billing\r\n\r\n  },\r\n  {\r\n    path: '/myMachineDetail',\r\n    // sidebarName: 'My Machine Datail ',\r\n    component: MyMachinesDetail\r\n  },\r\n  {\r\n    path: '/myFactoryFloorDetail',\r\n    // sidebarName: 'My Factory Floor  Detail ',\r\n    component: MyFactoryFloorDetail\r\n  },\r\n\r\n\r\n];\r\n\r\nexport default Routes;","E:\\Struct\\frontend-public\\src\\containers\\MyMachines\\index.js",[],"E:\\Struct\\frontend-public\\sr