at cupidatat non proident sunt in culpa.\r\n                          </p>\r\n                                    <img src=\"assets/images/review-logo1.png\" alt=\"Image\" />\r\n                                </div>\r\n                            </div>\r\n                            <div className=\"item\">\r\n                                <div className=\"review-content\">\r\n                                    <i className=\"fa fa-quote-left\" aria-hidden=\"true\" />\r\n                                    <p>\r\n                                        Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident sunt in culpa.\r\n                          </p>\r\n                                    <img src=\"assets/images/review-logo2.png\" alt=\"Image\" />\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </section>\r\n        </div>\r\n       \r\n    )\r\n}\r\n","E:\\Struct\\frontend-public\\src\\containers\\Dashboard\\index.js",[],"E:\\Struct\\frontend-public\\src\\containers\\Manufacture\\index.js",[],"E:\\Struct\\frontend-public\\src\\containers\\Billing\\index.js",[],"E:\\Struct\\frontend-public\\src\\containers\\Purchaches\\index.js",[],"E:\\Struct\\frontend-public\\src\\components\\LoginPopup\\index.js",["198","199","200","201"],"import React from 'react'\r\nimport Box from '@material-ui/core/Box';\r\nimport Popover from '@material-ui/core/Popover';\r\nimport PopupState, { bindTrigger, bindPopover } from 'material-ui-popup-state';\r\nimport Logo from \"../../assets/images/loginLogo.jpg\"\r\nimport Button from '@material-ui/core/Button';\r\nimport {Link} from \"react-router-dom\";\r\n// import './style.css'\r\n\r\nexport default function LoginPopup({ popupState }) {\r\n\r\n  return (\r\n    <div>\r\n      <Popover className=\"main_popover\"\r\n        style={{\r\n          overflow: \"hidden\",\r\n          top: \"19px\",\r\n\r\n        }}\r\n        {...bindPopover(popupState)}\r\n        anchorOrigin={{\r\n          vertical: 'bottom',\r\n          horizontal: 'center',\r\n        }}\r\n        transformOrigin={{\r\n          vertical: 'top',\r\n          horizontal: 'center',\r\n        }}\r\n      >\r\n        <div style={{ overflow: \"hidden\", display: \"block\", height: \"566px\", width: \"400px\" }} >\r\n          <div style={{\r\n            height: \"221px\",\r\n            display: \"flex\",\r\n            justifyContent: \"center\"\r\n          }}>\r\n            <img src={Logo} style={{\r\n              height: \"130px\",\r\n              width: \"127px\",\r\n              margin: \"17px\",\r\n              borderRadius: \"86px\"\r\n            }}></img>\r\n          </div>\r\n          <div style={{\r\n            height: \"103px\",\r\n            textAlign: \"center\"\r\n          }}>\r\n            <h3>Profile</h3>\r\n          </div>\r\n          <div style={{\r\n            height: \"103px\",\r\n            textAlign: \"center\"\r\n          }}>\r\n            <h3>Theme</h3>\r\n          </div>\r\n          <div style={{\r\n            height: \"103px\",\r\n            textAlign: \"center\"\r\n          }}>\r\n            <Link to=\"/login\">\r\n            <Button style={{\r\n              height: \"50px\",\r\n              width: \"100px\"\r\n            }} \r\n            variant=\"contained\"\r\n             color=\"secondary\"\r\n             >\r\n              Logout\r\n            </Button>\r\n            </Link>\r\n          </div>\r\n        </div>\r\n      </Popover>\r\n    </div >\r\n  )\r\n}\r\n",{"ruleId":"202","replacedBy":"203"},{"ruleId":"204","replacedBy":"205"},{"ruleId":"206","severity":1,"message":"207","line":54,"column":11,"nodeType":"208","endLine":54,"endColumn":23},{"ruleId":"206","severity":1,"message":"207","line":56,"column":39,"nodeType":"208","end