etailLink }) {\r\n    let history = useHistory();\r\n    const classes = useStyles();\r\n\r\n    function handleClick() {\r\n\r\n        // history.push(\"/myMachineDetail\");\r\n        history.push(detailLink);\r\n    }\r\n    return (\r\n        <div className={classes.root}>\r\n\r\n            <GridList cellHeight={180} className={classes.gridList} cols={4}>\r\n\r\n                {TileData.map((tile) => (\r\n                    <GridListTile className={classes.gridListTile}>\r\n                        <ButtonBase>\r\n                            <Paper\r\n                                className={classes.paper}\r\n                                elevation={7}\r\n                                onClick={() => handleClick()} >\r\n\r\n                                <Grid container spacing={3} >\r\n\r\n                                    <Grid item style={{ alignItems: \"center\" }}>\r\n                                        <ButtonBase className={classes.image}>\r\n                                            <img className={classes.img} alt=\"complex\" src={Logo} />\r\n                                        </ButtonBase>\r\n                                    </Grid>\r\n\r\n                                    <Grid item xs={1} sm container style={{ alignItems: \"center\" }}>\r\n                                        <Grid item xs container direction=\"column\" spacing={2} >\r\n                                            <Grid item xs >\r\n                                                <Typography gutterBottom variant=\"subtitle1\">\r\n                                                    <div>\r\n                                                        Name: khfkjdhfjdhbkj\r\n                                                </div>\r\n                                                    <div>\r\n                                                        ID\r\n                                                </div>\r\n                                                </Typography>\r\n                                            </Grid>\r\n                                        </Grid>\r\n\r\n                                    </Grid>\r\n                                </Grid>\r\n                            </Paper>\r\n                        </ButtonBase>\r\n\r\n                    </GridListTile>\r\n                ))}\r\n            </GridList>\r\n\r\n        </div>\r\n    );\r\n}\r\n","E:\\Struct\\frontend-public\\src\\containers\\MyMachines\\TileData.js",[],"E:\\Struct\\frontend-public\\src\\containers\\MyMachineDetail\\index.js",[],"E:\\Struct\\frontend-public\\src\\containers\\MyFactoryFloorDetail\\index.js",[],"E:\\Struct\\frontend-public\\src\\containers\\login\\index.js",[],"E:\\Struct\\frontend-public\\src\\containers\\home\\index.js",["184","185","186","187","188","189","190","191","192","193","194","195","196","197"],"import React from 'react';\r\nimport RobotWeldingBackground from '../../assets/images/robot_welding.jpg'\r\nimport FabricateAnything from '../../assets/images/fabricate_anything.jpg'\r\nimport AssembleAnything from '../../assets/images/assemble_anything.jpg'\r\nimport Molding from '../../assets/images/molding.jpg'\r\nimport Prototype from '../../assets/images/prototype.jpg'\r\nimport Fabrication from '../../assets/images/fabrication.jpg'\r\nimport {Link} from \"react-router-dom\"\r\n\r\nexport default function Home() {\r\n    return (\r\n        \r\n        <div >\r\n            <div className=\"hero-section\" style={{ backgroundImage: `url(${RobotWeldingBackground})` }}>\r\n                <div className=\"hero-section-area paypal\">\r\n                    <div className=\"container paypal-flex\">\r\n                        <div className=\"hero-content\">\r\n                            \r\n                            <h1>Infinitely Scalable<br /> Manufacturing</h1>\r\n                            \r\n                            <p>We bring you the latest technology at your service</p>\r\n                 